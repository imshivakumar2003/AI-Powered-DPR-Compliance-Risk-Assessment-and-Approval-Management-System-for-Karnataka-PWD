# ============================================================
# Backend Environment Configuration
# ============================================================

# Security & JWT
SECRET_KEY=karnataka-pwd-dpr-ai-production-super-secret-key-2026-replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration
# Comma-separated list of allowed origins (e.g. your Vercel deployment URL and local development)
# Note: All *.vercel.app preview URLs are automatically permitted by default.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# LLM & AI APIs
# Add your Groq API key to power RAG, AI Suggestion generation, and Chatbot
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Configuration (Optional - for advanced RAG/vector storage)
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dpr_rag_system

# Server Port (Render automatically sets $PORT, defaults to 8000 locally)
PORT=8000

# Storage Paths (Optional - defaults to data/ and uploads/ folders)
# DB_DIR=/opt/render/project/src/Backend/data
# UPLOAD_DIR=/opt/render/project/src/Backend/uploads
